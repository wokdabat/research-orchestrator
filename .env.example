# Copy this file to .env and fill in your values
# uv will load .env automatically when running scripts

# Required — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — controls which Claude model the subagents use
# Defaults to claude-sonnet-4-20250514 if not set
# RESEARCH_MCP_MODEL=claude-sonnet-4-20250514

# Optional — HTTP transport port (default 8000)
# Only used when running: uv run server.py --http
# RESEARCH_MCP_PORT=8000

# Optional — max concurrent web fetches per job (default 5)
# RESEARCH_MCP_MAX_CONCURRENT=5
